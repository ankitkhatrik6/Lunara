<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark cold-start theme: black window background, so the status-bar icons
         must be light. Mirrors values/themes.xml for the night configuration. -->
    <style name="Theme.Lunara" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@color/lunara_background</item>
        <item name="android:navigationBarColor">@color/lunara_background</item>
        <item name="android:windowBackground">@drawable/splash_background</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>